# Copy this file to .env, then replace only the Telegram values on your own computer.
# The real .env file is ignored by Git and must never be committed.

# terminal: default local registration prompt
# telegram: Telegram Bot registration prompt
LOCAL_FACE_RECOGNITION_REGISTRATION_CHANNEL=terminal

# Uncomment the three lines below to use Telegram instead of Terminal.
# LOCAL_FACE_RECOGNITION_REGISTRATION_CHANNEL=telegram
# LOCAL_FACE_RECOGNITION_TELEGRAM_BOT_TOKEN=replace_with_your_botfather_token
# LOCAL_FACE_RECOGNITION_TELEGRAM_ALLOWED_CHAT_ID=replace_with_your_authorized_chat_id
